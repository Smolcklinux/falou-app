{
  "expo": {
    "name": "Falou",
    "slug": "falou-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "falouapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "backgroundColor": "#1a1a2e",
    "primaryColor": "#6c63ff",
    "description": "App de salas de voz interativas - Falou",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.falou.app",
      "buildNumber": "1.0.0",
      "infoPlist": {
        "NSCameraUsageDescription": "O Falou precisa acessar sua câmera para tirar foto de perfil",
        "NSPhotoLibraryUsageDescription": "O Falou precisa acessar suas fotos para escolher avatar",
        "NSMicrophoneUsageDescription": "O Falou precisa acessar seu microfone para você falar nas salas de voz"
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#6c63ff"
      },
      "package": "com.falou.app",
      "versionCode": 4,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_IMAGES"
      ],
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
    [
      "expo-build-properties",
      {
        "android": {
          "compileSdkVersion": 34,
          "targetSdkVersion": 34,
          "buildToolsVersion": "34.0.0",
          "kotlinVersion": "1.9.24",
          "minSdkVersion": 23
        }
      }
    ],
      [
        "expo-image-picker",
        {
          "photosPermission": "O Falou precisa acessar suas fotos para escolher seu avatar.",
          "cameraPermission": "O Falou precisa acessar sua câmera para tirar foto de perfil."
        }
      ],
      [
        "expo-av",
        {
          "microphonePermission": "O Falou precisa acessar seu microfone para você falar nas salas de voz."
        }
      ],
      "react-native-permissions",
      "expo-build-properties"
    ],
    "assetBundlePatterns": [
      "**/*"
    ],
    "extra": {
      "eas": {
        "projectId": "1327cbfe-9b25-476e-a9dc-538b573fcbf2"
      }
    },
    "owner": "pudim0147",
    "experiments": {
      "tsconfigPaths": false
    }
  }
}
